{
  "name": "orbit",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.7.0 <25.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm build:packages && concurrently -k -n money,contracts,api,web -c gray,gray,blue,magenta \"pnpm --filter @orbit/money dev\" \"pnpm --filter @orbit/contracts dev\" \"pnpm --filter @orbit/api dev\" \"pnpm --filter @orbit/web dev\"",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && pnpm --filter \"./apps/**\" build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.json",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "pnpm build:packages && pnpm -r test",
    "test:cov": "pnpm build:packages && pnpm -r test:cov",
    "test:int": "pnpm --filter @orbit/api test:int",
    "test:isolation": "pnpm --filter @orbit/api test:isolation",
    "test:arch": "pnpm --filter @orbit/api test:arch",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @orbit/api db:migrate",
    "db:reset": "pnpm --filter @orbit/api db:reset",
    "db:seed": "pnpm --filter @orbit/api db:seed",
    "infra:up": "docker compose -f infra/compose/compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f infra/compose/compose.dev.yml down",
    "infra:reset": "docker compose -f infra/compose/compose.dev.yml down -v && pnpm infra:up && pnpm db:migrate && pnpm db:seed",
    "ci:local": "node infra/scripts/ci-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "concurrently": "9.2.5",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
