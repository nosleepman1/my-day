# ORBIT - variables d environnement (INFRASTRUCTURE.md 6). Valeurs FICTIVES uniquement.
# Developpement local : copier ce fichier vers apps/api/.env (ignore par Git).
# Staging et production : les secrets arrivent par fichiers montes (<NOM>_FILE), jamais en clair (ADR-031).

# --- Socle (PHASE-00) ---
NODE_ENV=development
APP_ENV=local
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
# Role applicatif sans droit DDL. Port 5433 : evite un PostgreSQL deja installe sur la machine.
DATABASE_URL=postgresql://orbit_app:orbit_dev_only@localhost:5433/orbit
# Role proprietaire, utilise uniquement par prisma migrate.
DATABASE_MIGRATION_URL=postgresql://orbit_owner:orbit_dev_only@localhost:5433/orbit

# URL publique directe de l API (webhooks, n8n) ; obligatoire et en https en deploiement (PHASE-03).
API_PUBLIC_URL=http://localhost:3000
# SHA de l image deployee (pose par l image Docker) ; journalise au demarrage, jamais expose.
APP_VERSION=dev

# --- E-mail (PHASE-01, ADR-042) ---
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# none (Mailpit) | starttls (587) | tls (465) ; chiffre et authentifie obligatoires en deploiement.
SMTP_SECURITY=none
# SMTP_USER=fake-smtp-user
# SMTP_PASSWORD=  (SMTP_PASSWORD_FILE hors local)
MAIL_FROM="ORBIT <no-reply@orbit.localhost>"
# Staging : seuls ces destinataires (adresses ou @domaine) recoivent des e-mails.
# MAIL_ALLOWLIST=@example.test

# --- Suivi d erreurs (PHASE-03) : Sentry SaaS region UE, obligatoire en deploiement ---
# SENTRY_DSN=https://fakekey@o0.ingest.de.sentry.io/1
# SENTRY_ENVIRONMENT=staging

# --- Inscription et mots de passe (PHASE-01, ADR-026, ADR-039) ---
# closed | allowlist | open. allowlist : seules les adresses listees peuvent s inscrire.
REGISTRATION_MODE=allowlist
REGISTRATION_ALLOWLIST=abdou@example.test
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
# Duree plancher (ms) des reponses d inscription : ne revele pas si un compte existe.
AUTH_UNIFORM_RESPONSE_MS=750
# Sessions (jours) : inactivite glissante et duree absolue (SECURITY.md 3.2).
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Cle HMAC des compteurs anti-abus (32 caracteres min). Fichier monte (RATE_LIMIT_HMAC_KEY_FILE) hors local.
RATE_LIMIT_HMAC_KEY=local-dev-only-rate-limit-key-change-me-0000
RATE_LIMIT_ENABLED=true
LOGIN_DELAY_UNIT_MS=250
