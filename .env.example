# ORBIT - variables d environnement (INFRASTRUCTURE.md 6). Valeurs FICTIVES uniquement.
# Developpement local : copier ce fichier vers apps/api/.env (ignore par Git).
# Staging et production : les secrets arrivent par fichiers montes (<NOM>_FILE), jamais en clair (ADR-031).

# --- Socle (PHASE-00) ---
NODE_ENV=development
APP_ENV=local
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
# Role applicatif sans droit DDL. Port 5433 : evite un PostgreSQL deja installe sur la machine.
DATABASE_URL=postgresql://orbit_app:orbit_dev_only@localhost:5433/orbit
# Role proprietaire, utilise uniquement par prisma migrate.
DATABASE_MIGRATION_URL=postgresql://orbit_owner:orbit_dev_only@localhost:5433/orbit

# --- E-mail (PHASE-01) ---
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="ORBIT <no-reply@orbit.localhost>"

# --- Inscription et mots de passe (PHASE-01, ADR-026, ADR-039) ---
# closed | allowlist | open. allowlist : seules les adresses listees peuvent s inscrire.
REGISTRATION_MODE=allowlist
REGISTRATION_ALLOWLIST=abdou@example.test
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
# Duree plancher (ms) des reponses d inscription : ne revele pas si un compte existe.
AUTH_UNIFORM_RESPONSE_MS=750
# Sessions (jours) : inactivite glissante et duree absolue (SECURITY.md 3.2).
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
