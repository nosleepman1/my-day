{
  "name": "@orbit/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "cli": "node --env-file-if-exists=.env dist/cli/cli.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project architecture",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:arch": "vitest run --project architecture",
    "test:isolation": "vitest run --project isolation --passWithNoTests",
    "test:cov": "vitest run --project unit --project integration --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed/seed.ts",
    "pretest": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@orbit/contracts": "workspace:*",
    "@orbit/money": "workspace:*",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.7.0",
    "helmet": "8.3.0",
    "nestjs-cls": "6.3.1",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.1.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@orbit/config": "workspace:*",
    "@testcontainers/postgresql": "11.14.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "testcontainers": "11.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
