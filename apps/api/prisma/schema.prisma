// Schema de donnees ORBIT (DATA_MODEL.md). Conventions : modeles PascalCase singuliers,
// tables snake_case au pluriel via @@map, colonnes snake_case via @map (CODING_STANDARDS 3.2).
// Les objets que Prisma ne sait pas exprimer (CHECK, index partiels, declencheurs, droits)
// sont ecrits a la main dans les migrations et listes dans prisma/manual-objects.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_MIGRATION_URL")
  extensions = [citext, unaccent, pg_trgm]
}

// ============================================================================
// M01 - Identite, sessions, preferences, audit (PHASE-01, DATA_MODEL.md M01)
// ============================================================================

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION

  @@map("user_status")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  EMAIL_CHANGED
  ADMIN_ACTION
  ACCOUNT_DELETION
  SECURITY
  LIMIT

  @@map("session_revoke_reason")
}

enum EmailTokenPurpose {
  VERIFY_SIGNUP
  CHANGE_EMAIL

  @@map("email_token_purpose")
}

enum LoginEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  EMAIL_CHANGED
  REAUTH_SUCCEEDED
  REAUTH_FAILED
  ACCOUNT_LOCKED
  MFA_SUCCEEDED
  MFA_FAILED

  @@map("login_event_type")
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  AUTOMATION
  AI
  API_KEY
  INTEGRATION

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum UiTheme {
  SYSTEM
  LIGHT
  DARK

  @@map("ui_theme")
}

model User {
  id                String     @id @db.Uuid
  email             String     @unique @db.Citext
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(80)
  firstName         String?    @map("first_name") @db.VarChar(80)
  lastName          String?    @map("last_name") @db.VarChar(80)
  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  preferences             UserPreference?
  ideas                   Idea[]
  projects                Project[]
  tasks                   Task[]
  taskDependencies        TaskDependency[]
  tags                    Tag[]
  ideaTags                IdeaTag[]
  taskTags                TaskTag[]
  projectTags             ProjectTag[]
  noteTags                NoteTag[]
  notes                   Note[]
  noteLinks               NoteLink[]
  financialAccounts       FinancialAccount[]
  transactionCategories   TransactionCategory[]
  counterparties          Counterparty[]
  transactions            Transaction[]
  cancelledTransactions   Transaction[]           @relation("CancelledTransactions")
  ledgerEntries           LedgerEntry[]
  idempotencyKeys         IdempotencyKey[]
  debts                   Debt[]
  debtRepayments          DebtRepayment[]
  recurringTransactions   RecurringTransaction[]
  recurringOccurrences    RecurringOccurrence[]

  @@index([status, createdAt], map: "ix_users__status_created")
  @@map("users")
}

model Session {
  id                String               @id @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  tokenHash         Bytes                @unique @map("token_hash")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(6)
  reauthAt          DateTime?            @map("reauth_at") @db.Timestamptz(6)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason      SessionRevokeReason? @map("revoke_reason")
  ip                String?              @db.Inet
  userAgentLabel    String?              @map("user_agent_label") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@index([absoluteExpiresAt], map: "ix_sessions__absolute_expires")
  @@map("sessions")
}

model EmailVerificationToken {
  id          String            @id @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  tokenHash   Bytes             @unique @map("token_hash")
  purpose     EmailTokenPurpose
  targetEmail String            @map("target_email") @db.Citext
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?         @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "ix_email_verification_tokens__expires")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   Bytes     @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "ix_password_reset_tokens__expires")
  @@map("password_reset_tokens")
}

model UserPreference {
  userId                String    @id @map("user_id") @db.Uuid
  locale                String    @default("fr") @db.VarChar(10)
  timezone              String    @default("Africa/Dakar") @db.VarChar(64)
  defaultCurrency       String    @default("XOF") @map("default_currency") @db.Char(3)
  dateFormat            String    @default("dd/MM/yyyy") @map("date_format") @db.VarChar(20)
  weekStartsOn          Int       @default(1) @map("week_starts_on") @db.SmallInt
  theme                 UiTheme   @default(SYSTEM)
  enabledModules        String[]  @map("enabled_modules")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [defaultCurrency], references: [code], onDelete: NoAction)

  @@map("user_preferences")
}

/// Journal de connexion en ajout seul, sans FK (DATA_MODEL.md M01).
model LoginEvent {
  id             String         @id @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  emailHmac      Bytes?         @map("email_hmac")
  eventType      LoginEventType @map("event_type")
  failureCode    String?        @map("failure_code") @db.VarChar(40)
  sessionId      String?        @map("session_id") @db.Uuid
  ip             String?        @db.Inet
  userAgentLabel String?        @map("user_agent_label") @db.VarChar(200)
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([userId, occurredAt(sort: Desc)], map: "ix_login_events__user_time")
  @@map("login_events")
}

/// Journal d audit en ajout seul, sans FK (DATA_MODEL.md M01, ADR-029).
model AuditLog {
  id            String         @id @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  action        String         @db.VarChar(80)
  entityType    String?        @map("entity_type") @db.VarChar(60)
  entityId      String?        @map("entity_id") @db.Uuid
  outcome       AuditOutcome   @default(SUCCESS)
  requestId     String?        @map("request_id") @db.VarChar(64)
  correlationId String?        @map("correlation_id") @db.VarChar(64)
  ip            String?        @db.Inet
  metadata      Json           @default("{}")
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([userId, occurredAt(sort: Desc)], map: "ix_audit_logs__user_time")
  @@index([userId, entityType, entityId, occurredAt(sort: Desc)], map: "ix_audit_logs__entity")
  @@map("audit_logs")
}

// ============================================================================
// M03 - Organisation : idees, projets, taches, tags, notes (PHASE-04, DATA_MODEL.md M03)
// Toutes les relations entre tables metier sont des FK composites (user_id, x_id) (ADR-007).
// Les FK « SET NULL (colonne) » sont reecrites en SQL manuel (DATA_MODEL.md §1.4, §2.2).
// ============================================================================

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority_level")
}

enum CaptureSource {
  MANUAL
  QUICK_CAPTURE
  EMAIL
  WHATSAPP
  VOICE
  IMPORT
  AI
  AUTOMATION
  RECURRENCE

  @@map("capture_source")
}

enum IdeaStatus {
  INBOX
  TO_REVIEW
  EVALUATED
  SELECTED
  IN_PROGRESS
  REALIZED
  ABANDONED

  @@map("idea_status")
}

enum ProjectType {
  FREELANCE
  PERSONAL_PRODUCT
  LEARNING
  INTERNAL

  @@map("project_type")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ABANDONED

  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@map("task_status")
}

enum NoteKind {
  NOTE
  MEETING
  REFERENCE
  CHECKLIST
  LOG

  @@map("note_kind")
}

enum ContentFormat {
  MARKDOWN
  PLAIN

  @@map("content_format")
}

model Idea {
  id                 String         @id @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  title              String         @db.VarChar(200)
  description        String?
  status             IdeaStatus     @default(INBOX)
  priority           PriorityLevel?
  domain             String?        @db.VarChar(60)
  potentialScore     Int?           @map("potential_score") @db.SmallInt
  capturedAt         DateTime       @default(now()) @map("captured_at") @db.Timestamptz(6)
  source             CaptureSource  @default(MANUAL)
  sourceRef          String?        @map("source_ref") @db.VarChar(255)
  clientCaptureId    String?        @map("client_capture_id") @db.Uuid
  convertedProjectId String?        @map("converted_project_id") @db.Uuid
  decisionNote       String?        @map("decision_note")
  version            Int            @default(1)
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User       @relation(fields: [userId], references: [id], onDelete: NoAction)
  convertedProject Project?   @relation("IdeaConvertedProject", fields: [userId, convertedProjectId], references: [userId, id], onDelete: NoAction)
  tags             IdeaTag[]
  tasks            Task[]
  noteLinks        NoteLink[]

  @@unique([userId, id])
  @@map("ideas")
}

model Project {
  id          String         @id @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  name        String         @db.VarChar(120)
  slug        String         @db.Citext
  description String?
  type        ProjectType    @default(PERSONAL_PRODUCT)
  status      ProjectStatus  @default(PLANNED)
  priority    PriorityLevel?
  startsOn    DateTime?      @map("starts_on") @db.Date
  targetOn    DateTime?      @map("target_on") @db.Date
  completedOn DateTime?      @map("completed_on") @db.Date
  color          String?        @db.VarChar(7)
  budgetMinor    BigInt?        @map("budget_minor")
  budgetCurrency String?        @map("budget_currency") @db.Char(3)
  version        Int            @default(1)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction)
  currency     Currency?     @relation(fields: [budgetCurrency], references: [code], onDelete: NoAction)
  sourceIdeas  Idea[]        @relation("IdeaConvertedProject")
  tasks        Task[]
  tags         ProjectTag[]
  noteLinks             NoteLink[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, id])
  @@map("projects")
}

model Task {
  id                  String         @id @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  title               String         @db.VarChar(300)
  description         String?
  status              TaskStatus     @default(TODO)
  priority            PriorityLevel?
  projectId           String?        @map("project_id") @db.Uuid
  ideaId              String?        @map("idea_id") @db.Uuid
  parentTaskId        String?        @map("parent_task_id") @db.Uuid
  startsOn            DateTime?      @map("starts_on") @db.Date
  dueDate             DateTime?      @map("due_date") @db.Date
  dueAt               DateTime?      @map("due_at") @db.Timestamptz(6)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(6)
  estimatedMinutes    Int?           @map("estimated_minutes")
  actualMinutes       Int?           @map("actual_minutes")
  recurrenceRule      String?        @map("recurrence_rule") @db.VarChar(500)
  recurrenceAnchorOn  DateTime?      @map("recurrence_anchor_on") @db.Date
  recurrenceLocalTime DateTime?      @map("recurrence_local_time") @db.Time(6)
  recurrenceTimezone  String?        @map("recurrence_timezone") @db.VarChar(64)
  nextOccurrenceAt    DateTime?      @map("next_occurrence_at") @db.Timestamptz(6)
  recurrenceSeriesId  String?        @map("recurrence_series_id") @db.Uuid
  occurrenceDate      DateTime?      @map("occurrence_date") @db.Date
  source              CaptureSource  @default(MANUAL)
  sourceRef           String?        @map("source_ref") @db.VarChar(255)
  clientCaptureId     String?        @map("client_capture_id") @db.Uuid
  kanbanRank          String?        @map("kanban_rank") @db.VarChar(64)
  version             Int            @default(1)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: NoAction)
  project      Project?         @relation(fields: [userId, projectId], references: [userId, id], onDelete: NoAction)
  idea         Idea?            @relation(fields: [userId, ideaId], references: [userId, id], onDelete: NoAction)
  parent       Task?            @relation("TaskSubtasks", fields: [userId, parentTaskId], references: [userId, id], onDelete: Cascade)
  subtasks     Task[]           @relation("TaskSubtasks")
  series       Task?            @relation("TaskOccurrences", fields: [userId, recurrenceSeriesId], references: [userId, id], onDelete: Cascade)
  occurrences  Task[]           @relation("TaskOccurrences")
  dependencies TaskDependency[] @relation("DependencyBlocked")
  dependents   TaskDependency[] @relation("DependencyBlocking")
  tags         TaskTag[]
  noteLinks    NoteLink[]

  @@unique([userId, id])
  @@map("tasks")
}

/// « task_id dépend de depends_on_task_id » ; l'absence de cycle est garantie par un déclencheur.
model TaskDependency {
  userId          String   @map("user_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User @relation(fields: [userId], references: [id], onDelete: NoAction)
  task      Task @relation("DependencyBlocked", fields: [userId, taskId], references: [userId, id], onDelete: Cascade)
  dependsOn Task @relation("DependencyBlocking", fields: [userId, dependsOnTaskId], references: [userId, id], onDelete: Cascade)

  @@id([userId, taskId, dependsOnTaskId])
  @@index([userId, dependsOnTaskId], map: "ix_task_dependencies__depends_on")
  @@map("task_dependencies")
}

model Tag {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.Citext
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: NoAction)
  ideas    IdeaTag[]
  tasks    TaskTag[]
  projects ProjectTag[]
  notes    NoteTag[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@map("tags")
}

model IdeaTag {
  userId    String   @map("user_id") @db.Uuid
  ideaId    String   @map("idea_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction)
  idea Idea @relation(fields: [userId, ideaId], references: [userId, id], onDelete: Cascade)
  tag  Tag  @relation(fields: [userId, tagId], references: [userId, id], onDelete: Cascade)

  @@id([userId, ideaId, tagId])
  @@index([userId, tagId], map: "ix_idea_tags__tag")
  @@map("idea_tags")
}

model TaskTag {
  userId    String   @map("user_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction)
  task Task @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade)
  tag  Tag  @relation(fields: [userId, tagId], references: [userId, id], onDelete: Cascade)

  @@id([userId, taskId, tagId])
  @@index([userId, tagId], map: "ix_task_tags__tag")
  @@map("task_tags")
}

model ProjectTag {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction)
  project Project @relation(fields: [userId, projectId], references: [userId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [userId, tagId], references: [userId, id], onDelete: Cascade)

  @@id([userId, projectId, tagId])
  @@index([userId, tagId], map: "ix_project_tags__tag")
  @@map("project_tags")
}

model NoteTag {
  userId    String   @map("user_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction)
  note Note @relation(fields: [userId, noteId], references: [userId, id], onDelete: Cascade)
  tag  Tag  @relation(fields: [userId, tagId], references: [userId, id], onDelete: Cascade)

  @@id([userId, noteId, tagId])
  @@index([userId, tagId], map: "ix_note_tags__tag")
  @@map("note_tags")
}

model Note {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  title           String?       @db.VarChar(200)
  content         String        @default("")
  contentFormat   ContentFormat @default(MARKDOWN) @map("content_format")
  kind            NoteKind      @default(NOTE)
  source          CaptureSource @default(MANUAL)
  sourceRef       String?       @map("source_ref") @db.VarChar(255)
  clientCaptureId String?       @map("client_capture_id") @db.Uuid
  version         Int           @default(1)
  pinnedAt        DateTime?     @map("pinned_at") @db.Timestamptz(6)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: NoAction)
  tags  NoteTag[]
  links NoteLink[]

  @@unique([userId, id])
  @@map("notes")
}

/// Lien explicite d'une note vers UNE cible (ADR-018) ; cibles ajoutées par les phases suivantes.
model NoteLink {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  ideaId         String?  @map("idea_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  transactionId  String?  @map("transaction_id") @db.Uuid
  counterpartyId String?  @map("counterparty_id") @db.Uuid
  debtId         String?  @map("debt_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction)
  note         Note          @relation(fields: [userId, noteId], references: [userId, id], onDelete: Cascade)
  idea         Idea?         @relation(fields: [userId, ideaId], references: [userId, id], onDelete: Cascade)
  project      Project?      @relation(fields: [userId, projectId], references: [userId, id], onDelete: Cascade)
  task         Task?         @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade)
  transaction  Transaction?  @relation(fields: [userId, transactionId], references: [userId, id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [userId, counterpartyId], references: [userId, id], onDelete: Cascade)
  debt         Debt?         @relation(fields: [userId, debtId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, id])
  @@index([userId, noteId], map: "ix_note_links__note")
  @@map("note_links")
}

// =============================================================================
// M04 : Finance, cœur (PHASE-05)
// =============================================================================

enum AccountType {
  CASH
  MOBILE_MONEY
  BANK
  PAYMENT_ACCOUNT
  OTHER

  @@map("account_type")
}

enum CategoryKind {
  INCOME
  EXPENSE

  @@map("category_kind")
}

enum CounterpartyKind {
  PERSON
  ORGANIZATION

  @@map("counterparty_kind")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  BORROWING
  LOAN
  REFUND
  ADJUSTMENT

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  VALIDATED
  CANCELLED

  @@map("transaction_status")
}

enum EconomicClass {
  INCOME_OPERATING
  INCOME_OTHER
  GIFT_RECEIVED
  LOAN_COLLECTION
  EXPENSE_OPERATING
  EXPENSE_FEE
  GIFT_GIVEN
  DEBT_REPAYMENT
  INTERNAL_TRANSFER
  DEBT_DRAWDOWN
  LOAN_DISBURSEMENT
  REFUND_RECEIVED
  REFUND_ISSUED
  BALANCE_ADJUSTMENT

  @@map("economic_class")
}

enum TransactionSource {
  MANUAL
  RECURRENCE
  AUTOMATION
  AI
  IMPORT
  INTEGRATION

  @@map("transaction_source")
}

enum FxRateSource {
  MANUAL
  PROVIDER_STATEMENT
  FIXED_PEG

  @@map("fx_rate_source")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

/// Devises supportées (globale, sans user_id).
model Currency {
  code        String   @id @db.Char(3)
  numericCode Int      @map("numeric_code") @db.SmallInt
  exponent    Int      @db.SmallInt
  symbol      String   @db.VarChar(8)
  nameFr      String   @map("name_fr") @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  financialAccounts     FinancialAccount[]
  transactions          Transaction[]
  ledgerEntries         LedgerEntry[]
  userPreferences       UserPreference[]
  projects              Project[]
  debts                 Debt[]
  recurringTransactions RecurringTransaction[]
  recurringOccurrences  RecurringOccurrence[]

  @@map("currencies")
}

/// Comptes financiers d'un utilisateur (espèces, Wave, Orange Money, banque...).
model FinancialAccount {
  id                  String      @id @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  name                String      @db.VarChar(80)
  type                AccountType
  provider            String?     @db.VarChar(60)
  currency            String      @db.Char(3)
  openingBalanceMinor BigInt      @default(0) @map("opening_balance_minor")
  openedOn            DateTime    @map("opened_on") @db.Date
  allowOverdraft      Boolean     @default(false) @map("allow_overdraft")
  overdraftLimitMinor BigInt?     @map("overdraft_limit_minor")
  includeInNetWorth   Boolean     @default(true) @map("include_in_net_worth")
  color               String?     @db.VarChar(7)
  icon                String?     @db.VarChar(40)
  sortOrder           Int         @default(0) @map("sort_order")
  notes               String?
  archivedAt          DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                             User                   @relation(fields: [userId], references: [id], onDelete: NoAction)
  currencyRel                      Currency               @relation(fields: [currency], references: [code], onDelete: NoAction)
  ledgerEntries                    LedgerEntry[]
  recurringTransactionsSource      RecurringTransaction[] @relation("RecurringSourceAccount")
  recurringTransactionsDestination RecurringTransaction[] @relation("RecurringDestinationAccount")

  @@unique([userId, id])
  @@unique([userId, id, currency])
  @@index([userId, sortOrder], map: "ix_financial_accounts__active")
  @@map("financial_accounts")
}

/// Catégories de transactions par utilisateur, avec hiérarchie à 1 niveau.
model TransactionCategory {
  id                   String                @id @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  name                 String                @db.VarChar(60)
  kind                 CategoryKind
  parentId             String?               @map("parent_id") @db.Uuid
  defaultEconomicClass EconomicClass         @map("default_economic_class")
  isSystem             Boolean               @default(false) @map("is_system")
  systemKey            String?               @map("system_key") @db.VarChar(80)
  color                String?               @db.VarChar(7)
  icon                 String?               @db.VarChar(40)
  sortOrder            Int                   @default(0) @map("sort_order")
  archivedAt           DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction)
  parent                TransactionCategory?   @relation("CategoryHierarchy", fields: [userId, parentId], references: [userId, id], onDelete: NoAction)
  children              TransactionCategory[]  @relation("CategoryHierarchy")
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, id])
  @@unique([userId, systemKey])
  @@index([userId, kind, sortOrder], map: "ix_transaction_categories__kind")
  @@map("transaction_categories")
}

/// Contreparties (personnes physiques ou morales).
model Counterparty {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  name       String           @db.VarChar(120)
  kind       CounterpartyKind @default(PERSON)
  phone      String?          @db.VarChar(20)
  email      String?          @db.Citext
  notes      String?
  archivedAt DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction)
  transactions          Transaction[]
  noteLinks             NoteLink[]
  debts                 Debt[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, id])
  @@index([userId, name], map: "ix_counterparties__active")
  @@map("counterparties")
}

/// En-têtes de transactions financières (revenu, dépense, transfert, ajustement).
model Transaction {
  id                  String             @id @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  type                TransactionType
  status              TransactionStatus
  economicClass       EconomicClass      @map("economic_class")
  amountMinor         BigInt             @map("amount_minor")
  currency            String             @db.Char(3)
  occurredAt          DateTime           @map("occurred_at") @db.Timestamptz(6)
  valueDate           DateTime           @map("value_date") @db.Date
  description         String?            @db.VarChar(255)
  notes               String?
  categoryId          String?            @map("category_id") @db.Uuid
  counterpartyId      String?            @map("counterparty_id") @db.Uuid
  projectId           String?            @map("project_id") @db.Uuid
  parentTransactionId String?            @map("parent_transaction_id") @db.Uuid
  refundOfId          String?            @map("refund_of_id") @db.Uuid
  debtId              String?            @map("debt_id") @db.Uuid
  rate                Decimal?           @db.Decimal(20, 10)
  rateDate            DateTime?          @map("rate_date") @db.Date
  rateSource          FxRateSource?      @map("rate_source")
  source              TransactionSource  @default(MANUAL)
  idempotencyKey      String?            @map("idempotency_key") @db.VarChar(128)
  externalReference   String?            @map("external_reference") @db.VarChar(128)
  validatedAt         DateTime?          @map("validated_at") @db.Timestamptz(6)
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?            @map("cancelled_by") @db.Uuid
  cancelReason        String?            @map("cancel_reason") @db.VarChar(500)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                 @relation(fields: [userId], references: [id], onDelete: NoAction)
  currencyRel          Currency             @relation(fields: [currency], references: [code], onDelete: NoAction)
  category             TransactionCategory? @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)
  counterparty         Counterparty?        @relation(fields: [userId, counterpartyId], references: [userId, id], onDelete: NoAction)
  project              Project?             @relation(fields: [userId, projectId], references: [userId, id], onDelete: NoAction)
  parentTransaction    Transaction?         @relation("FeeTransactions", fields: [userId, parentTransactionId], references: [userId, id], onDelete: NoAction)
  feeTransactions      Transaction[]        @relation("FeeTransactions")
  refundOf             Transaction?         @relation("RefundTransactions", fields: [userId, refundOfId, currency], references: [userId, id, currency], onDelete: NoAction)
  refunds              Transaction[]        @relation("RefundTransactions")
  cancelledByUser      User?                @relation("CancelledTransactions", fields: [cancelledBy], references: [id], onDelete: NoAction)
  debtOrigin           Debt?                @relation("DebtOriginTransaction", fields: [userId, debtId], references: [userId, id], onDelete: NoAction)
  debtRepayments       DebtRepayment[]
  recurringOccurrences RecurringOccurrence[]
  ledgerEntries        LedgerEntry[]
  noteLinks            NoteLink[]

  @@unique([userId, id])
  @@unique([userId, id, currency])
  @@index([userId, valueDate(sort: Desc), id(sort: Desc)], map: "ix_transactions__journal")
  @@index([userId, status, valueDate], map: "ix_transactions__status_date")
  @@index([userId, categoryId, valueDate], map: "ix_transactions__category")
  @@index([userId, counterpartyId, valueDate], map: "ix_transactions__counterparty")
  @@index([userId, projectId], map: "ix_transactions__project")
  @@index([userId, parentTransactionId], map: "ix_transactions__parent")
  @@index([userId, refundOfId], map: "ix_transactions__refund_of")
  @@index([userId, debtId], map: "ix_transactions__debt")
  @@index([userId, externalReference], map: "ix_transactions__external_ref")
  @@map("transactions")
}

/// Écritures du registre comptable (au plus une par sens et par transaction).
model LedgerEntry {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amountMinor   BigInt         @map("amount_minor")
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id], onDelete: NoAction)
  transaction Transaction      @relation(fields: [userId, transactionId], references: [userId, id], onDelete: NoAction)
  account     FinancialAccount @relation(fields: [userId, accountId, currency], references: [userId, id, currency], onDelete: NoAction)
  currencyRel Currency         @relation(fields: [currency], references: [code], onDelete: NoAction)

  @@unique([userId, id])
  @@unique([userId, transactionId, direction])
  @@index([userId, accountId, transactionId], map: "ix_ledger_entries__account")
  @@map("ledger_entries")
}

/// Clés d'idempotence des opérations financières et sensibles.
model IdempotencyKey {
  id             String            @id @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  scope          String            @db.VarChar(80)
  key            String            @db.VarChar(128)
  requestHash    Bytes             @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  resourceId     String?           @map("resource_id") @db.Uuid
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@unique([userId, scope, key])
  @@index([expiresAt], map: "ix_idempotency_keys__expires")
  @@map("idempotency_keys")
}

// =============================================================================
// M05 : Dettes, créances, récurrences et prévisions (PHASE-06)
// =============================================================================

enum DebtType {
  PAYABLE
  RECEIVABLE

  @@map("debt_type")
}

enum DebtStatus {
  OPEN
  CANCELLED
  WRITTEN_OFF

  @@map("debt_status")
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED

  @@map("recurring_status")
}

enum RecurringGenerationMode {
  CONFIRM
  AUTO_PENDING

  @@map("recurring_generation_mode")
}

enum OccurrenceStatus {
  EXPECTED
  CONFIRMED
  SKIPPED

  @@map("occurrence_status")
}

/// Dettes (PAYABLE) et créances (RECEIVABLE) selon DATA_MODEL.md §3.5 (M05).
model Debt {
  id             String      @id @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           DebtType
  counterpartyId String      @map("counterparty_id") @db.Uuid
  title          String      @db.VarChar(160)
  description    String?
  principalMinor BigInt      @map("principal_minor")
  currency       String      @db.Char(3)
  openedOn       DateTime    @map("opened_on") @db.Date
  dueDate        DateTime?   @map("due_date") @db.Date
  status         DebtStatus  @default(OPEN)
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  writtenOffAt   DateTime?   @map("written_off_at") @db.Timestamptz(6)
  closingReason  String?     @map("closing_reason") @db.VarChar(500)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User            @relation(fields: [userId], references: [id], onDelete: NoAction)
  counterparty       Counterparty    @relation(fields: [userId, counterpartyId], references: [userId, id], onDelete: NoAction)
  currencyRel        Currency        @relation(fields: [currency], references: [code], onDelete: NoAction)
  repayments         DebtRepayment[]
  originTransactions Transaction[]   @relation("DebtOriginTransaction")
  noteLinks          NoteLink[]

  @@unique([userId, id])
  @@unique([userId, id, currency])
  @@index([userId, counterpartyId], map: "ix_debts__counterparty")
  @@map("debts")
}

/// Imputations de remboursements de dettes selon DATA_MODEL.md §3.5 (M05).
model DebtRepayment {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  debtId        String   @map("debt_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  amountMinor   BigInt   @map("amount_minor")
  currency      String   @db.Char(3)
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction)
  debt        Debt        @relation(fields: [userId, debtId, currency], references: [userId, id, currency], onDelete: NoAction)
  transaction Transaction @relation(fields: [userId, transactionId, currency], references: [userId, id, currency], onDelete: NoAction)

  @@unique([userId, id])
  @@unique([userId, debtId, transactionId])
  @@unique([userId, transactionId])
  @@index([userId, debtId], map: "ix_debt_repayments__debt")
  @@map("debt_repayments")
}

/// Règles de transactions récurrentes selon DATA_MODEL.md §3.5 (M05).
model RecurringTransaction {
  id                   String                  @id @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  name                 String                  @db.VarChar(120)
  type                 TransactionType
  economicClass        EconomicClass           @map("economic_class")
  amountMinor          BigInt                  @map("amount_minor")
  currency             String                  @db.Char(3)
  accountId            String                  @map("account_id") @db.Uuid
  destinationAccountId String?                 @map("destination_account_id") @db.Uuid
  categoryId           String?                 @map("category_id") @db.Uuid
  counterpartyId       String?                 @map("counterparty_id") @db.Uuid
  projectId            String?                 @map("project_id") @db.Uuid
  generationMode       RecurringGenerationMode @default(CONFIRM) @map("generation_mode")
  reminderDaysBefore   Int                     @default(1) @map("reminder_days_before") @db.SmallInt
  status               RecurringStatus         @default(ACTIVE)
  recurrenceRule       String                  @map("recurrence_rule") @db.VarChar(500)
  recurrenceAnchorOn   DateTime                @map("recurrence_anchor_on") @db.Date
  recurrenceTimezone   String                  @map("recurrence_timezone") @db.VarChar(60)
  recurrenceLocalTime  DateTime?               @map("recurrence_local_time") @db.Time(6)
  nextOccurrenceAt     DateTime?               @map("next_occurrence_at") @db.Timestamptz(6)
  generatedUntil       DateTime?               @map("generated_until") @db.Date
  notes                String?
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                  @relation(fields: [userId], references: [id], onDelete: NoAction)
  currencyRel        Currency              @relation(fields: [currency], references: [code], onDelete: NoAction)
  account            FinancialAccount      @relation("RecurringSourceAccount", fields: [userId, accountId, currency], references: [userId, id, currency], onDelete: NoAction)
  destinationAccount FinancialAccount?     @relation("RecurringDestinationAccount", fields: [userId, destinationAccountId], references: [userId, id], onDelete: NoAction)
  category           TransactionCategory?  @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)
  counterparty       Counterparty?         @relation(fields: [userId, counterpartyId], references: [userId, id], onDelete: NoAction)
  project            Project?              @relation(fields: [userId, projectId], references: [userId, id], onDelete: NoAction)
  occurrences        RecurringOccurrence[]

  @@unique([userId, id])
  @@index([userId, status], map: "ix_recurring_transactions__status")
  @@map("recurring_transactions")
}

/// Échéances matérialisées de transactions récurrentes selon DATA_MODEL.md §3.5 (M05).
model RecurringOccurrence {
  id                     String           @id @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  recurringTransactionId String           @map("recurring_transaction_id") @db.Uuid
  dueOn                  DateTime         @map("due_on") @db.Date
  expectedAmountMinor    BigInt           @map("expected_amount_minor")
  currency               String           @db.Char(3)
  status                 OccurrenceStatus @default(EXPECTED)
  transactionId          String?          @map("transaction_id") @db.Uuid
  confirmedAt            DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  skippedAt              DateTime?        @map("skipped_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user                 User                 @relation(fields: [userId], references: [id], onDelete: NoAction)
  currencyRel          Currency             @relation(fields: [currency], references: [code], onDelete: NoAction)
  recurringTransaction RecurringTransaction @relation(fields: [userId, recurringTransactionId], references: [userId, id], onDelete: Cascade)
  transaction          Transaction?         @relation(fields: [userId, transactionId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, id])
  @@unique([userId, recurringTransactionId, dueOn])
  @@map("recurring_occurrences")
}
